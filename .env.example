# Copy to .env.local and fill in. Never commit real values.
# Server-only: do not prefix any of these with NEXT_PUBLIC_.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Inbox that receives the contact form messages
CONTACT_TO_EMAIL=
# Sender address; use onboarding@resend.dev until a domain is verified in Resend
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Production origin allowed to call /api/contact (no trailing slash), e.g. https://your-site.vercel.app
SITE_URL=
